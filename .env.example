# Execution profile: local | aws-demo | showcase
# local selects deterministic simulation and does not call cloud providers.
EXECUTION_PROFILE=local

# Master switch. false forces every agentic cloud capability off and selects
# local deterministic simulation, even when the flags below are true.
AWS_AGENTIC_FEATURES_ENABLED=false

# Cloud, agent runtime, and model-provider integrations.
CLOUD_INTEGRATIONS_ENABLED=false
AGENT_RUNTIME_ENABLED=false
MODEL_PROVIDER_ENABLED=false

# Feature flags. Managed retrieval, long-term memory, and automatic schedules
# default to false.
AGENTIC_FEATURES_ENABLED=false
MULTI_AGENT_EXECUTION_ENABLED=false
CLOUD_AGENT_RUNTIME_ENABLED=false
MANAGED_RETRIEVAL_ENABLED=false
LONG_TERM_MEMORY_ENABLED=false
AUTOMATIC_SCHEDULES_ENABLED=false

# Local PostgreSQL used by the API. The quality gate does not require this file.
DATABASE_URL=postgresql+psycopg://opsmesh:opsmesh@localhost:5433/opsmesh
