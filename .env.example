# Execution profile: local | aws-demo | showcase
# local selects deterministic simulation and does not call cloud providers.
EXECUTION_PROFILE=local

# Master switch. false forces every agentic cloud capability off and selects
# local deterministic simulation, even when the flags below are true.
AWS_AGENTIC_FEATURES_ENABLED=false

# Cloud, agent runtime, and model-provider integrations.
CLOUD_INTEGRATIONS_ENABLED=false
AGENT_RUNTIME_ENABLED=false
MODEL_PROVIDER_ENABLED=false

# Specialists that call the model provider, in conversion order.
# Used only when the model provider is actually on. Empty selects every specialist.
MODEL_BACKED_AGENTS=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1

# Feature flags. Managed retrieval, long-term memory, and automatic schedules
# default to false.
AGENTIC_FEATURES_ENABLED=false
MULTI_AGENT_EXECUTION_ENABLED=false
CLOUD_AGENT_RUNTIME_ENABLED=false

# Specialists that use the agent runtime, in conversion order.
# Used only when the cloud agent runtime is actually on. Empty selects none.
REMOTE_RUNTIME_AGENTS=
# agent=endpoint pairs, for example inventory=arn:aws:bedrock-agentcore:us-east-1:000000000000:runtime/inventory
AGENT_RUNTIME_ENDPOINTS=
# agent=identity pairs. Empty uses opsmesh/<agent> for each specialist.
AGENT_RUNTIME_IDENTITIES=
AGENT_RUNTIME_QUALIFIER=DEFAULT

# Tool calls use Amazon Bedrock AgentCore Gateway only when the master switch
# and this flag are both true. Otherwise the local registry is used.
CLOUD_TOOL_GATEWAY_ENABLED=false
TOOL_GATEWAY_ENDPOINT=
# agent=identity pairs. Empty uses opsmesh/<agent> for each specialist.
TOOL_GATEWAY_IDENTITIES=
TOOL_GATEWAY_PROTOCOL_VERSION=2026-07-28

MANAGED_RETRIEVAL_ENABLED=false
LONG_TERM_MEMORY_ENABLED=false
AUTOMATIC_SCHEDULES_ENABLED=false

# Local PostgreSQL used by the API. The quality gate does not require this file.
DATABASE_URL=postgresql+psycopg://opsmesh:opsmesh@localhost:5433/opsmesh
