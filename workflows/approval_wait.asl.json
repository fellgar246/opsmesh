{
  "Comment": "Deterministic approval wait. Agent planning stays outside this machine.",
  "StartAt": "Waiting",
  "States": {
    "Waiting": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "TimeoutSeconds": 259200,
      "Parameters": {
        "FunctionName": "${handler_arn}",
        "Payload": {
          "action": "wait",
          "proposal_id.$": "$.proposal_id",
          "tenant_id.$": "$.tenant_id",
          "arguments_hash.$": "$.arguments_hash",
          "task_token.$": "${task_token}"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "ResultPath": "$.timeout",
          "Next": "Expired"
        }
      ],
      "Next": "RouteSignal"
    },
    "RouteSignal": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.signal",
          "StringEquals": "approve",
          "Next": "Approved"
        },
        {
          "Variable": "$.signal",
          "StringEquals": "reject",
          "Next": "Rejected"
        }
      ],
      "Default": "Expired"
    },
    "Approved": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.hash_matches",
          "BooleanEquals": false,
          "Next": "ApprovedStopped"
        }
      ],
      "Default": "DraftCreated"
    },
    "ApprovedStopped": {
      "Type": "Succeed"
    },
    "DraftCreated": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${handler_arn}",
        "Payload": {
          "action": "create_draft",
          "proposal_id.$": "$.proposal_id",
          "tenant_id.$": "$.tenant_id",
          "arguments_hash.$": "$.arguments_hash"
        }
      },
      "ResultPath": "$.draft",
      "Next": "Notified"
    },
    "Notified": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${handler_arn}",
        "Payload": {
          "action": "notify",
          "proposal_id.$": "$.proposal_id",
          "tenant_id.$": "$.tenant_id"
        }
      },
      "End": true
    },
    "Rejected": {
      "Type": "Succeed"
    },
    "Expired": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${handler_arn}",
        "Payload": {
          "action": "expire_approval",
          "proposal_id.$": "$.proposal_id",
          "tenant_id.$": "$.tenant_id"
        }
      },
      "End": true
    }
  }
}
